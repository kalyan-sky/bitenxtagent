{
    "name": "bitenxt/support-agent",
    "description": "BiteNXT customer support chatbot: order status and help, backed by Magento GraphQL and Claude.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "anthropic-ai/sdk": "^0.54.0",
        "guzzlehttp/guzzle": "^7.8 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Bitenxt\\SupportAgent\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Bitenxt\\SupportAgent\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": true }
    }
}
