# --- AI providers, tried in order (primary first, then fallbacks) ---
# Any provider: add its name here and set LLM_<NAME>_TYPE (anthropic | openai-compatible),
# LLM_<NAME>_MODEL, LLM_<NAME>_API_KEY and, for openai-compatible, LLM_<NAME>_BASE_URL.
# "gemini", "openrouter", "claude" and "openai" have built-in defaults (type, base URL).
LLM_PROVIDERS=gemini,openrouter
LLM_GEMINI_MODEL=
LLM_GEMINI_API_KEY=
# OpenRouter model ID from openrouter.ai/models that supports tool calling, e.g. anthropic/<claude model>
LLM_OPENROUTER_MODEL=
LLM_OPENROUTER_API_KEY=
# To call Anthropic directly instead: add "claude" to LLM_PROVIDERS and set LLM_CLAUDE_API_KEY
# (model defaults to claude-opus-5-5; LLM_CLAUDE_EFFORT=low).
# Several keys per provider are allowed (comma-separated); the next is tried on 401/403/429.
# Optional per-provider daily token cap (0 = none): over it, the next provider answers.
LLM_GEMINI_DAILY_TOKEN_LIMIT=0
LLM_OPENROUTER_DAILY_TOKEN_LIMIT=0

# --- Token limits (input + output) against attacks and sudden spikes; 0 = no limit ---
MAX_OUTPUT_TOKENS=400
TOKEN_LIMIT_CUSTOMER_PER_DAY=100000
TOKEN_LIMIT_GLOBAL_PER_HOUR=200000
TOKEN_LIMIT_GLOBAL_PER_DAY=1000000
# Only the last N question/answer pairs go to the AI; order lookups skip the AI (FAST_PATH=off to disable)
AI_HISTORY_TURNS=6
FAST_PATH=on

# --- Magento (customer-scoped GraphQL only; this service never holds an admin token) ---
MAGENTO_GRAPHQL_URL=https://uat-magento.bitenxt.com/graphql
MAGENTO_TIMEOUT_SECONDS=10

# --- Widget / HTTP ---
# Comma-separated list of frontends allowed to call /chat (CORS)
ALLOWED_ORIGINS=https://uat-pro.bitenxt.com
STORE_NAME=BiteNXT
SUPPORT_EMAIL=support@bitenxt.com
SUPPORT_PHONE=

# --- Limits ---
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_CONVERSATION=40
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200
# Chat history kept this many days after the last message
HISTORY_RETENTION_DAYS=90
# Quiet minutes after which the bot starts a fresh conversation (the window keeps the thread)
CONVERSATION_IDLE_MINUTES=30

# --- Human handoff: optional webhook (Slack/Teams/helpdesk) that receives escalations ---
HANDOFF_WEBHOOK_URL=

# Where sessions, rate-limit counters and logs are written
STORAGE_DIR=./var

# --- Storage / hosting ---
# file = local files under STORAGE_DIR (development, single server)
# firestore = shared by all Cloud Run instances (the Docker image defaults to this)
STORAGE_BACKEND=file
# Only needed outside Google Cloud; on Cloud Run the project is detected automatically
GCP_PROJECT=
FIRESTORE_DATABASE=(default)
# For local testing against the Firestore emulator, e.g. localhost:8085
FIRESTORE_EMULATOR_HOST=
# file = var/logs/chat.jsonl, stderr = structured logs for Cloud Logging
LOG_TARGET=file
# Proxies in front of the app that append to X-Forwarded-For (0 locally, 1 on Cloud Run)
TRUSTED_PROXY_HOPS=0
