# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low is plenty for support chat; raise to medium if answers feel shallow
CLAUDE_EFFORT=low

# --- Magento (customer-scoped GraphQL only; this service never holds an admin token) ---
MAGENTO_GRAPHQL_URL=https://uat-magento.bitenxt.com/graphql
MAGENTO_TIMEOUT_SECONDS=10

# --- Widget / HTTP ---
# Comma-separated list of frontends allowed to call /chat (CORS)
ALLOWED_ORIGINS=https://pro.bitenxt.com
STORE_NAME=BiteNXT
SUPPORT_EMAIL=support@bitenxt.com
SUPPORT_PHONE=

# --- Limits ---
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_SESSION=40
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200
SESSION_TTL_SECONDS=86400

# --- Human handoff: optional webhook (Slack/Teams/helpdesk) that receives escalations ---
HANDOFF_WEBHOOK_URL=

# Where sessions, rate-limit counters and logs are written
STORAGE_DIR=./var
