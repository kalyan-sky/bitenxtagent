# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low is plenty for support chat; raise to medium if answers feel shallow
CLAUDE_EFFORT=low

# --- Magento (customer-scoped GraphQL only; this service never holds an admin token) ---
MAGENTO_GRAPHQL_URL=https://uat-magento.bitenxt.com/graphql
MAGENTO_TIMEOUT_SECONDS=10

# --- Widget / HTTP ---
# Comma-separated list of frontends allowed to call /chat (CORS)
ALLOWED_ORIGINS=https://uat-pro.bitenxt.com
STORE_NAME=BiteNXT
SUPPORT_EMAIL=support@bitenxt.com
SUPPORT_PHONE=

# --- Limits ---
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_CONVERSATION=40
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200
# Chat history kept this many days after the last message
HISTORY_RETENTION_DAYS=90
# Quiet minutes after which the bot starts a fresh conversation (the window keeps the thread)
CONVERSATION_IDLE_MINUTES=30
# Enables /staff.html (transcripts for the support team). Long random secret, e.g. openssl rand -hex 24
STAFF_ACCESS_KEY=

# --- Human handoff: optional webhook (Slack/Teams/helpdesk) that receives escalations ---
HANDOFF_WEBHOOK_URL=

# Where sessions, rate-limit counters and logs are written
STORAGE_DIR=./var

# --- Storage / hosting ---
# file = local files under STORAGE_DIR (development, single server)
# firestore = shared by all Cloud Run instances (the Docker image defaults to this)
STORAGE_BACKEND=file
# Only needed outside Google Cloud; on Cloud Run the project is detected automatically
GCP_PROJECT=
FIRESTORE_DATABASE=(default)
# For local testing against the Firestore emulator, e.g. localhost:8085
FIRESTORE_EMULATOR_HOST=
# file = var/logs/chat.jsonl, stderr = structured logs for Cloud Logging
LOG_TARGET=file
# Proxies in front of the app that append to X-Forwarded-For (0 locally, 1 on Cloud Run)
TRUSTED_PROXY_HOPS=0
